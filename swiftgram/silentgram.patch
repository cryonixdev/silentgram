new file mode 100644
index 00000000..aa41c4d9
--- /dev/null
+++ b/submodules/TelegramCore/Sources/SyncCore/SyncCore_SGDeletedMessageAttribute.swift
@@ -0,0 +1,53 @@
+import Foundation
+import Postbox
+
+// MARK: Silent Gram — пометка «сообщение удалено собеседником»
+public class SGDeletedMessageAttribute: MessageAttribute {
+    public let date: Int32
+
+    public init(date: Int32) {
+        self.date = date
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+    }
+}
+
+public extension Message {
+    var sgIsDeleted: Bool {
+        return self.attributes.contains(where: { $0 is SGDeletedMessageAttribute })
+    }
+}
+
+// MARK: Silent Gram — история правок (старые версии текста, от старых к новым)
+public class SGEditHistoryMessageAttribute: MessageAttribute {
+    public let texts: [String]
+
+    public init(texts: [String]) {
+        self.texts = texts
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.texts = decoder.decodeStringArrayForKey("t")
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeStringArray(self.texts, forKey: "t")
+    }
+}
+
+public extension Message {
+    var sgEditHistory: [String] {
+        for attribute in self.attributes {
+            if let attribute = attribute as? SGEditHistoryMessageAttribute {
+                return attribute.texts
+            }
+        }
+        return []
+    }
+}
