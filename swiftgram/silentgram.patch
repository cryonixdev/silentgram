+// MARK: Silent Gram — сохранение удалённых сообщений и истории правок
+
+private let sgDeletedMark = "\n\n🗑 Удалено"
+private let sgEditMark = "\n\n✏️ Было: "
+
+private func sgStoreMessage(_ m: Message, text: String) -> StoreMessage {
+    return StoreMessage(id: m.id, customStableId: nil, globallyUniqueId: m.globallyUniqueId, groupingKey: m.groupingKey, threadId: m.threadId, timestamp: m.timestamp, flags: StoreMessageFlags(m.flags), tags: m.tags, globalTags: m.globalTags, localTags: m.localTags, forwardInfo: m.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: m.author?.id, text: text, attributes: m.attributes, media: m.media)
+}
+
+private func sgIsEphemeral(_ m: Message) -> Bool {
+    for attribute in m.attributes {
+        if attribute is AutoremoveTimeoutMessageAttribute || attribute is AutoclearTimeoutMessageAttribute {
+            return true
+        }
+    }
+    for media in m.media {
+        if media is TelegramMediaAction || media is TelegramMediaExpiredContent {
+            return true
+        }
+    }
+    return false
+}
+
+/// true — сообщения сохранены с пометкой и удалять их не нужно.
+private func sgKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> Bool {
+    guard SGSimpleSettings.shared.saveDeletedMessages, !ids.isEmpty else {
+        return false
+    }
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id), !sgIsEphemeral(message) else {
+            return false
+        }
+    }
+    for id in ids {
+        transaction.updateMessage(id, update: { current in
+            if current.text.hasSuffix(sgDeletedMark) {
+                return .skip
+            }
+            return .update(sgStoreMessage(current, text: current.text + sgDeletedMark))
+        })
+    }
+    return true
+}
+
+private func sgApplyEditHistory(previous: Message, updated: StoreMessage) -> StoreMessage {
+    guard SGSimpleSettings.shared.saveEditHistory, !sgIsEphemeral(previous) else {
+        return updated
+    }
+    let base: String
+    let suffix: String
+    if let range = previous.text.range(of: sgEditMark) {
+        base = String(previous.text[..<range.lowerBound])
+        suffix = String(previous.text[range.lowerBound...])
+    } else {
+        base = previous.text
+        suffix = ""
+    }
+    let newText: String
+    if updated.text == base || base.isEmpty {
+        newText = updated.text + suffix
+    } else {
+        newText = updated.text + sgEditMark + base + suffix
+    }
+    if newText == updated.text {
+        return updated
+    }
+    return StoreMessage(id: updated.id, customStableId: updated.customStableId, globallyUniqueId: updated.globallyUniqueId, groupingKey: updated.groupingKey, threadId: updated.threadId, timestamp: updated.timestamp, flags: updated.flags, tags: updated.tags, globalTags: updated.globalTags, localTags: updated.localTags, forwardInfo: updated.forwardInfo, authorId: updated.authorId, text: newText, attributes: updated.attributes, media: updated.media)
+}
