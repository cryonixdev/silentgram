+// MARK: Silent Gram — сохранение удалённых сообщений и истории правок
+
+private let sgEditMark = "\n\n✏️ Было: "
+
+private func sgStoreMessage(_ m: Message, text: String, attributes: [MessageAttribute]) -> StoreMessage {
+    return StoreMessage(id: m.id, customStableId: nil, globallyUniqueId: m.globallyUniqueId, groupingKey: m.groupingKey, threadId: m.threadId, timestamp: m.timestamp, flags: StoreMessageFlags(m.flags), tags: m.tags, globalTags: m.globalTags, localTags: m.localTags, forwardInfo: m.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: m.author?.id, text: text, attributes: attributes, media: m.media)
+}
+
+private func sgIsEphemeral(_ m: Message) -> Bool {
+    for attribute in m.attributes {
+        if attribute is AutoremoveTimeoutMessageAttribute || attribute is AutoclearTimeoutMessageAttribute {
+            return true
+        }
+    }
+    for media in m.media {
+        if media is TelegramMediaAction || media is TelegramMediaExpiredContent {
+            return true
+        }
+    }
+    return false
+}
+
+/// true — сообщения сохранены с пометкой и удалять их не нужно.
+private func sgKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> Bool {
+    guard SGSimpleSettings.shared.saveDeletedMessages, !ids.isEmpty else {
+        return false
+    }
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id), !sgIsEphemeral(message) else {
+            return false
+        }
+    }
+    let now = Int32(CFAbsoluteTimeGetCurrent() + NSTimeIntervalSince1970)
+    for id in ids {
+        transaction.updateMessage(id, update: { current in
+            if current.sgIsDeleted {
+                return .skip
+            }
+            return .update(sgStoreMessage(current, text: current.text, attributes: current.attributes + [SGDeletedMessageAttribute(date: now)]))
+        })
+    }
+    return true
+}
+
+private func sgApplyEditHistory(previous: Message, updated: StoreMessage) -> StoreMessage {
+    guard SGSimpleSettings.shared.saveEditHistory, !sgIsEphemeral(previous) else {
+        return updated
+    }
+    // Старые версии могли хранить историю прямо в тексте — отрезаем её
+    var previousText = previous.text
+    if let range = previousText.range(of: sgEditMark) {
+        previousText = String(previousText[..<range.lowerBound])
+    }
+    var history = previous.sgEditHistory
+    if !previousText.isEmpty && previousText != updated.text && history.last != previousText {
+        history.append(previousText)
+    }
+    if history.isEmpty {
+        return updated
+    }
+    var attributes = updated.attributes.filter { !($0 is SGEditHistoryMessageAttribute) }
+    attributes.append(SGEditHistoryMessageAttribute(texts: history))
+    for attribute in previous.attributes where attribute is SGDeletedMessageAttribute {
+        attributes.append(attribute)
+    }
+    return StoreMessage(id: updated.id, customStableId: updated.customStableId, globallyUniqueId: updated.globallyUniqueId, groupingKey: updated.groupingKey, threadId: updated.threadId, timestamp: updated.timestamp, flags: updated.flags, tags: updated.tags, globalTags: updated.globalTags, localTags: updated.localTags, forwardInfo: updated.forwardInfo, authorId: updated.authorId, text: updated.text, attributes: attributes, media: updated.media)
+}
